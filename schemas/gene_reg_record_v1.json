{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeneReg-Eval evidence-grounded relation record v1",
  "type": "object",
  "required": [
    "record_id", "pmid", "species", "evidence_spans", "regulator_mention",
    "relation", "object_mention", "object_kind", "context_mentions", "abstract_support"
  ],
  "properties": {
    "record_id": {"type": "string"},
    "pmid": {"type": "string", "pattern": "^[0-9]+$"},
    "species": {"enum": ["human", "mouse"]},
    "evidence_spans": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "regulator_mention": {"type": "string", "minLength": 1},
    "relation": {"enum": ["Activation", "Repression", "Unknown"]},
    "object_mention": {"type": "string", "minLength": 1},
    "object_kind": {"enum": ["gene", "regulatory_element", "protein", "other"]},
    "context_mentions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "abstract_support": {"enum": ["ABSTRACT_SUPPORTED", "ABSTRACT_UNSUPPORTED", "ABSTRACT_AMBIGUOUS"]},
    "trrust_reference": {"type": "object"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}

